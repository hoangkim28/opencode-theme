    "tokenColors": [
        {
            "scope": [
                "comment",
                "punctuation.definition.comment"
            ],
            "settings": {
                "foreground": "#8A8585",
                "fontStyle": "italic"
            }
        },
        {
            "scope": [
                "constant",
                "constant.character",
                "constant.language",
                "constant.numeric",
                "constant.other"
            ],
            "settings": {
                "foreground": "#F5A742"
            }
        },
        {
            "scope": [
                "entity.name",
                "entity.name.type",
                "entity.name.class",
                "entity.name.namespace",
                "entity.name.tag",
                "entity.name.function"
            ],
            "settings": {
                "foreground": "#FAB283"
            }
        },
        {
            "scope": [
                "entity.name.type.class",
                "entity.name.type.namespace",
                "entity.other.inherited-class",
                "storage.type"
            ],
            "settings": {
                "foreground": "#E5C07B"
            }
        },
        {
            "scope": [
                "keyword",
                "keyword.control",
                "keyword.operator.new",
                "keyword.other.new"
            ],
            "settings": {
                "foreground": "#9D7CD8"
            }
        },
        {
            "scope": [
                "keyword.operator",
                "keyword.operator.assignment",
                "keyword.operator.arithmetic",
                "keyword.operator.logical"
            ],
            "settings": {
                "foreground": "#56B6C2"
            }
        },
        {
            "scope": [
                "markup.heading",
                "markup.bold"
            ],
            "settings": {
                "foreground": "#FAB283",
                "fontStyle": "bold"
            }
        },
        {
            "scope": [
                "markup.link",
                "markup.underline.link"
            ],
            "settings": {
                "foreground": "#5C9CF5"
            }
        },
        {
            "scope": [
                "punctuation",
                "punctuation.definition"
            ],
            "settings": {
                "foreground": "#CFCECD"
            }
        },
        {
            "scope": [
                "storage",
                "storage.modifier"
            ],
            "settings": {
                "foreground": "#9D7CD8"
            }
        },
        {
            "scope": [
                "string",
                "string.quoted",
                "string.other"
            ],
            "settings": {
                "foreground": "#7FD88F"
            }
        },
        {
            "scope": [
                "string.regexp",
                "string.escape"
            ],
            "settings": {
                "foreground": "#56B6C2"
            }
        },
        {
            "scope": [
                "support.class",
                "support.type",
                "support.type.property-name"
            ],
            "settings": {
                "foreground": "#E5C07B"
            }
        },
        {
            "scope": [
                "support.function",
                "support.function.magic"
            ],
            "settings": {
                "foreground": "#FAB283"
            }
        },
        {
            "scope": [
                "support.constant",
                "support.variable",
                "support.variable.property"
            ],
            "settings": {
                "foreground": "#5C9CF5"
            }
        },
        {
            "scope": [
                "variable",
                "variable.language",
                "variable.parameter"
            ],
            "settings": {
                "foreground": "#E06C75"
            }
        },
        {
            "scope": [
                "variable.property"
            ],
            "settings": {
                "foreground": "#CFCECD"
            }
        },
        {
            "scope": [
                "invalid",
                "invalid.illegal"
            ],
            "settings": {
                "foreground": "#E06C75",
                "fontStyle": "bold"
            }
        },
        {
            "scope": [
                "markup.quote",
                "markup.raw",
                "markup.raw.inline",
                "markup.italic"
            ],
            "settings": {
                "foreground": "#E5C07B"
            }
        },
        {
            "scope": [
                "markup.deleted"
            ],
            "settings": {
                "foreground": "#E06C75"
            }
        },
        {
            "scope": [
                "markup.inserted"
            ],
            "settings": {
                "foreground": "#7FD88F"
            }
        },
        {
            "scope": [
                "markup.changed"
            ],
            "settings": {
                "foreground": "#5C9CF5"
            }
        },
        {
            "scope": [
                "meta.function-call",
                "meta.method-call",
                "meta.arguments",
                "meta.brace",
                "meta.block"
            ],
            "settings": {
                "foreground": "#CFCECD"
            }
        },
        {
            "scope": [
                "meta.function-call.generic"
            ],
            "settings": {
                "foreground": "#FAB283"
            }
        },
        {
            "scope": [
                "meta.tag",
                "meta.tag.sgml",
                "meta.tag.xml",
                "entity.name.tag"
            ],
            "settings": {
                "foreground": "#E06C75"
            }
        },
        {
            "scope": [
                "meta.selector",
                "entity.other.attribute-name",
                "entity.other.attribute-name.html"
            ],
            "settings": {
                "foreground": "#E5C07B"
            }
        },
        {
            "scope": [
                "source.css selector",
                "source.css property-name"
            ],
            "settings": {
                "foreground": "#CFCECD"
            }
        }
    ]
}
