    "tokenColors": [
        {
            "scope": [
                "comment",
                "punctuation.definition.comment"
            ],
            "settings": {
                "foreground": "#8A8585",
                "fontStyle": "italic"
            }
        },
        {
            "scope": [
                "constant",
                "constant.character",
                "constant.language",
                "constant.numeric",
                "constant.other"
            ],
            "settings": {
                "foreground": "#D68C27"
            }
        },
        {
            "scope": [
                "entity.name",
                "entity.name.type",
                "entity.name.class",
                "entity.name.namespace",
                "entity.name.tag",
                "entity.name.function"
            ],
            "settings": {
                "foreground": "#3B7DD8"
            }
        },
        {
            "scope": [
                "entity.name.type.class",
                "entity.name.type.namespace",
                "entity.other.inherited-class",
                "storage.type"
            ],
            "settings": {
                "foreground": "#B0851F"
            }
        },
        {
            "scope": [
                "keyword",
                "keyword.control",
                "keyword.operator.new",
                "keyword.other.new"
            ],
            "settings": {
                "foreground": "#9D7CD8"
            }
        },
        {
            "scope": [
                "keyword.operator",
                "keyword.operator.assignment",
                "keyword.operator.arithmetic",
                "keyword.operator.logical"
            ],
            "settings": {
                "foreground": "#318795"
            }
        },
        {
            "scope": [
                "markup.heading",
                "markup.bold"
            ],
            "settings": {
                "foreground": "#3B7DD8",
                "fontStyle": "bold"
            }
        },
        {
            "scope": [
                "markup.link",
                "markup.underline.link"
            ],
            "settings": {
                "foreground": "#3B7DD8"
            }
        },
        {
            "scope": [
                "punctuation",
                "punctuation.definition"
            ],
            "settings": {
                "foreground": "#211E1E"
            }
        },
        {
            "scope": [
                "storage",
                "storage.modifier"
            ],
            "settings": {
                "foreground": "#9D7CD8"
            }
        },
        {
            "scope": [
                "string",
                "string.quoted",
                "string.other"
            ],
            "settings": {
                "foreground": "#3D9A57"
            }
        },
        {
            "scope": [
                "string.regexp",
                "string.escape"
            ],
            "settings": {
                "foreground": "#318795"
            }
        },
        {
            "scope": [
                "support.class",
                "support.type",
                "support.type.property-name"
            ],
            "settings": {
                "foreground": "#B0851F"
            }
        },
        {
            "scope": [
                "support.function",
                "support.function.magic"
            ],
            "settings": {
                "foreground": "#3B7DD8"
            }
        },
        {
            "scope": [
                "support.constant",
                "support.variable",
                "support.variable.property"
            ],
            "settings": {
                "foreground": "#3B7DD8"
            }
        },
        {
            "scope": [
                "variable",
                "variable.language",
                "variable.parameter"
            ],
            "settings": {
                "foreground": "#D1383D"
            }
        },
        {
            "scope": [
                "variable.property"
            ],
            "settings": {
                "foreground": "#211E1E"
            }
        },
        {
            "scope": [
                "invalid",
                "invalid.illegal"
            ],
            "settings": {
                "foreground": "#D1383D",
                "fontStyle": "bold"
            }
        },
        {
            "scope": [
                "markup.quote",
                "markup.raw",
                "markup.raw.inline",
                "markup.italic"
            ],
            "settings": {
                "foreground": "#B0851F"
            }
        },
        {
            "scope": [
                "markup.deleted"
            ],
            "settings": {
                "foreground": "#D1383D"
            }
        },
        {
            "scope": [
                "markup.inserted"
            ],
            "settings": {
                "foreground": "#3D9A57"
            }
        },
        {
            "scope": [
                "markup.changed"
            ],
            "settings": {
                "foreground": "#3B7DD8"
            }
        },
        {
            "scope": [
                "meta.function-call",
                "meta.method-call",
                "meta.arguments",
                "meta.brace",
                "meta.block"
            ],
            "settings": {
                "foreground": "#211E1E"
            }
        },
        {
            "scope": [
                "meta.function-call.generic"
            ],
            "settings": {
                "foreground": "#3B7DD8"
            }
        },
        {
            "scope": [
                "meta.tag",
                "meta.tag.sgml",
                "meta.tag.xml",
                "entity.name.tag"
            ],
            "settings": {
                "foreground": "#D1383D"
            }
        },
        {
            "scope": [
                "meta.selector",
                "entity.other.attribute-name",
                "entity.other.attribute-name.html"
            ],
            "settings": {
                "foreground": "#B0851F"
            }
        },
        {
            "scope": [
                "source.css selector",
                "source.css property-name"
            ],
            "settings": {
                "foreground": "#211E1E"
            }
        }
    ]
}
